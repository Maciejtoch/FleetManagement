@page
@model FleetManagement.Areas.Identity.Pages.Account.LoginModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>FleetManagement – Login</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://unpkg.com/aos@2.3.1/dist/aos.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="auth-page">
    <div class="auth-theme-toggle-wrap">
        <button type="button" class="btn btn-outline-light btn-sm auth-theme-toggle" id="authThemeToggle" aria-label="Toggle dark mode">
            <i class="bi bi-moon-stars"></i>
            <span>Dark mode</span>
        </button>
    </div>

    <div class="auth-shell d-flex justify-content-center align-items-center" data-aos="zoom-in" data-aos-duration="600">
        <div class="auth-card">
            <div class="auth-brand" data-aos="fade-down" data-aos-delay="120">
                <div class="auth-brand-mark">
                    <i class="bi bi-truck-front"></i>
                </div>
                <div>
                    <p class="auth-eyebrow">Fleet operations</p>
                    <h4>FleetManagement</h4>
                </div>
            </div>

            <form method="post" class="auth-form">
                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label"></label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" />
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label"></label>
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
                </div>

                <button type="submit" class="btn btn-primary w-100 auth-button">
                    <i class="bi bi-box-arrow-in-right"></i>
                    Sign in
                </button>

                <div asp-validation-summary="ModelOnly" class="text-danger mt-3"></div>
            </form>
        </div>
    </div>

    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init({ once: true });

        (function () {
            const body = document.body;
            const toggle = document.getElementById('authThemeToggle');
            const savedTheme = localStorage.getItem('fleet-theme') || 'light';

            const applyTheme = function (theme) {
                const isDark = theme === 'dark';
                body.classList.toggle('dark-mode', isDark);
                if (toggle) {
                    const icon = toggle.querySelector('i');
                    const label = toggle.querySelector('span');
                    if (icon) {
                        icon.className = isDark ? 'bi bi-sun' : 'bi bi-moon-stars';
                    }
                    if (label) {
                        label.textContent = isDark ? 'Light mode' : 'Dark mode';
                    }
                }
            };

            applyTheme(savedTheme);

            if (toggle) {
                toggle.addEventListener('click', function () {
                    const nextTheme = body.classList.contains('dark-mode') ? 'light' : 'dark';
                    localStorage.setItem('fleet-theme', nextTheme);
                    applyTheme(nextTheme);
                });
            }
        })();
    </script>
</body>
</html>
