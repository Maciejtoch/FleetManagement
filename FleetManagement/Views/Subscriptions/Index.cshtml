@{
    ViewData["Title"] = "Subskrypcje";
    var tenants = (IEnumerable<FleetManagement.Core.Models.Tenant>)ViewBag.Tenants;
}

<div class="page-heading">
    <div>
        <h1 class="page-title">Subskrypcje i planowanie platformy</h1>
        <p class="page-subtitle">Zarządzanie poziomem abonamentu dla aktywnych tenantów.</p>
    </div>
</div>

<div class="row g-4">
    @foreach (var tenant in tenants)
    {
        <div class="col-lg-6">
            <div class="dashboard-card h-100">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h3 class="mb-1">@tenant.Name</h3>
                        <div class="text-muted">@tenant.Domain</div>
                    </div>
                    <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis px-3 py-2">@tenant.PlanType</span>
                </div>

                <dl class="row mb-0 small">
                    <dt class="col-sm-5">Status</dt>
                    <dd class="col-sm-7">@tenant.Status</dd>
                    <dt class="col-sm-5">Aktywacja</dt>
                    <dd class="col-sm-7">@(tenant.IsActive ? "Aktywna" : "Nieaktywna")</dd>
                    <dt class="col-sm-5">Ważna do</dt>
                    <dd class="col-sm-7">@(tenant.SubscriptionEndsAt?.ToString("dd.MM.yyyy") ?? "Brak")</dd>
                    <dt class="col-sm-5">Utworzono</dt>
                    <dd class="col-sm-7">@tenant.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</dd>
                </dl>

                <div class="mt-3 d-flex gap-2 flex-wrap">
                    <a asp-controller="AdminTenants" asp-action="Details" asp-route-tenantId="@tenant.Id" class="btn btn-sm btn-outline-primary">Szczegóły</a>
                    <form asp-action="Suspend" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="tenantId" value="@tenant.Id" />
                        <input type="hidden" name="reason" value="Zawieszenie administracyjne" />
                        <button type="submit" class="btn btn-sm btn-warning" @(tenant.IsActive ? "" : "disabled")>Zawieś</button>
                    </form>
                    <form asp-action="Restore" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="tenantId" value="@tenant.Id" />
                        <button type="submit" class="btn btn-sm btn-success" @(tenant.IsActive ? "disabled" : "")>Przywróć</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
