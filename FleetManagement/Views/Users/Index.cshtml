@model IEnumerable<FleetManagement.Models.UserListViewModel>

@{
    ViewData["Title"] = "Users";
}

<h2>Users</h2>

<a asp-action="Create" class="btn btn-primary mb-3">➕ Add user</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Email</th>
            <th>Name</th>
            <th>Role</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Email</td>
                <td>@user.FullName</td>
                <td>@user.Role</td>
                <td>
                    @(user.IsActive ? "Active" : "Disabled")
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@user.Id"
                       class="btn btn-sm btn-outline-primary">
                        Edit
                    </a>

                    <a asp-action="EditRole" asp-route-id="@user.Id"
                       class="btn btn-sm btn-outline-secondary">
                        Change role
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
