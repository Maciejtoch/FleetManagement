@model FleetManagement.Models.EditUserRoleViewModel

<h2>Change role</h2>

<form method="post">
    <input type="hidden" asp-for="UserId" />
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label>Email</label>
        <input class="form-control" value="@Model.Email" disabled />
    </div>

    <div class="mb-3">
        <label>Role</label>
        <select asp-for="Role" class="form-select">
            <option value="User">Kierowca</option>
            <option value="TenantAdmin">Admin (dla tenanta)</option>
        </select>
    </div>

    <button class="btn btn-primary">Save</button>
    <a href="@(!string.IsNullOrWhiteSpace(Model.ReturnUrl) ? Model.ReturnUrl : Url.Action("Index"))" class="btn btn-secondary">Cancel</a>
</form>
