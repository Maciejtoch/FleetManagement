@model FleetManagement.Models.EditUserSecurityViewModel
@{
    ViewData["Title"] = "Reset hasła";
}

<div class="page-heading">
    <div>
        <h1 class="page-title">Reset hasła</h1>
        <p class="page-subtitle">Ustaw nowe hasło dla @Model.FullName</p>
    </div>
</div>

<div class="dashboard-card mx-auto" style="max-width: 700px;">
    <form asp-action="ResetPassword" method="post">
        <input type="hidden" asp-for="UserId" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label"></label>
            <input asp-for="NewPassword" class="form-control" type="password" />
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-outline-secondary">Powrót</a>
            <button type="submit" class="btn btn-primary">Zapisz hasło</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
