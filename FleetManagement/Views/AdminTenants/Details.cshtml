@model FleetManagement.Models.AdminTenantDetailsViewModel
@{
    ViewData["Title"] = "Hub tenanta";
    var tenant = Model.Tenant;
    var activeTab = Model.ActiveTab ?? "overview";
}

<div class="page-heading">
    <div>
        <h1 class="page-title">@tenant.Name</h1>
        <p class="page-subtitle">@tenant.Domain · @tenant.PlanType</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">Powrót</a>
        <a asp-action="Edit" asp-route-id="@tenant.Id" class="btn btn-primary">Edytuj tenanta</a>
    </div>
</div>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><a class="nav-link @(activeTab == "overview" ? "active" : "")" asp-route-tab="overview" asp-route-tenantId="@tenant.Id">Przegląd</a></li>
    <li class="nav-item"><a class="nav-link @(activeTab == "users" ? "active" : "")" asp-route-tab="users" asp-route-tenantId="@tenant.Id">Użytkownicy</a></li>
    <li class="nav-item"><a class="nav-link @(activeTab == "vehicles" ? "active" : "")" asp-route-tab="vehicles" asp-route-tenantId="@tenant.Id">Pojazdy</a></li>
    <li class="nav-item"><a class="nav-link @(activeTab == "subscription" ? "active" : "")" asp-route-tab="subscription" asp-route-tenantId="@tenant.Id">Subskrypcja</a></li>
    <li class="nav-item"><a class="nav-link @(activeTab == "audit" ? "active" : "")" asp-route-tab="audit" asp-route-tenantId="@tenant.Id">Audyt</a></li>
    <li class="nav-item"><a class="nav-link @(activeTab == "reports" ? "active" : "")" asp-route-tab="reports" asp-route-tenantId="@tenant.Id">Raporty</a></li>
</ul>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (activeTab == "overview")
{
    <div class="row g-4">
        <div class="col-lg-4">
            <div class="dashboard-card h-100">
                <h3>Podstawowe dane</h3>
                <dl class="row mb-0 small">
                    <dt class="col-sm-5">Status</dt><dd class="col-sm-7">@tenant.Status</dd>
                    <dt class="col-sm-5">Plan</dt><dd class="col-sm-7">@tenant.PlanType</dd>
                    <dt class="col-sm-5">Aktywność</dt><dd class="col-sm-7">@(tenant.IsActive ? "Aktywna" : "Zawieszona")</dd>
                    <dt class="col-sm-5">Data ważności</dt><dd class="col-sm-7">@(tenant.SubscriptionEndsAt?.ToString("dd.MM.yyyy") ?? "Brak")</dd>
                    <dt class="col-sm-5">Utworzono</dt><dd class="col-sm-7">@tenant.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</dd>
                </dl>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="dashboard-card h-100">
                <h3>Przegląd</h3>
                <dl class="row mb-0 small">
                    <dt class="col-sm-6">Użytkownicy</dt><dd class="col-sm-6">@Model.UserCount</dd>
                    <dt class="col-sm-6">Pojazdy</dt><dd class="col-sm-6">@Model.VehicleCount</dd>
                    <dt class="col-sm-6">Ostatnie logowanie</dt><dd class="col-sm-6">@(Model.LastLoginUtc.HasValue ? Model.LastLoginUtc.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm") : "-" )</dd>
                    <dt class="col-sm-6">Ostatni błąd</dt><dd class="col-sm-6">@(!string.IsNullOrWhiteSpace(Model.LastLoginError) ? Model.LastLoginError : "Brak")</dd>
                </dl>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="dashboard-card h-100">
                <h3>Ownerzy</h3>
                @if (Model.Users.Any(u => u.Role == "Owner"))
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var owner in Model.Users.Where(u => u.Role == "Owner").Take(5))
                        {
                            <li class="list-group-item px-0">@owner.FullName · @owner.Email</li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted mb-0">Brak właścicieli.</p>
                }
            </div>
        </div>
    </div>
}

@if (activeTab == "users")
{
    <div class="dashboard-card mb-3">
        <div class="d-flex gap-2 flex-wrap">
            <form asp-action="CreateOwner" asp-route-tenantId="@tenant.Id" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="email" name="email" class="form-control d-inline-block" style="max-width: 220px;" placeholder="owner@firma.pl" required />
                <input type="text" name="fullName" class="form-control d-inline-block" style="max-width: 180px;" placeholder="Imię i nazwisko" required />
                <input type="password" name="password" class="form-control d-inline-block" style="max-width: 180px;" placeholder="Hasło" required />
                <button type="submit" class="btn btn-primary">Dodaj ownera</button>
            </form>
            <form asp-action="CreateDriver" asp-route-tenantId="@tenant.Id" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="email" name="email" class="form-control d-inline-block" style="max-width: 220px;" placeholder="kierowca@firma.pl" required />
                <input type="text" name="fullName" class="form-control d-inline-block" style="max-width: 180px;" placeholder="Imię i nazwisko" required />
                <input type="password" name="password" class="form-control d-inline-block" style="max-width: 180px;" placeholder="Hasło" required />
                <button type="submit" class="btn btn-outline-primary">Dodaj kierowcę</button>
            </form>
        </div>
    </div>

    <div class="table-container">
        <table class="table">
            <thead><tr><th>Email</th><th>Imię</th><th>Rola</th><th>Status</th><th>Akcje</th></tr></thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td>@user.Email</td>
                        <td>@user.FullName</td>
                        <td>@user.Role</td>
                        <td>@(user.IsActive ? "Aktywny" : "Zablokowany")</td>
                        <td class="d-flex gap-2 flex-wrap">
                            <a asp-controller="Users" asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">Edytuj</a>
                            <a asp-controller="Users" asp-action="EditRole" asp-route-id="@user.Id" asp-route-returnUrl="@Url.Action("Details", "AdminTenants", new { tenantId = tenant.Id, tab = "users" })" class="btn btn-sm btn-outline-secondary">Zmień rolę</a>
                            <a asp-controller="Users" asp-action="ResetPassword" asp-route-id="@user.Id" asp-route-returnUrl="@Url.Action("Details", "AdminTenants", new { tenantId = tenant.Id, tab = "users" })" class="btn btn-sm btn-outline-dark">Reset hasła</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (activeTab == "vehicles")
{
    <div class="table-container">
        <table class="table">
            <thead><tr><th>Rejestracja</th><th>Marka</th><th>Model</th><th>VIN</th></tr></thead>
            <tbody>
                @foreach (var vehicle in Model.Vehicles)
                {
                    <tr>
                        <td>@vehicle.RegistrationNumber</td>
                        <td>@vehicle.Make</td>
                        <td>@vehicle.Model</td>
                        <td>@vehicle.VIN</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (activeTab == "subscription")
{
    <div class="dashboard-card">
        <h3>Subskrypcja</h3>
        <dl class="row mb-0">
            <dt class="col-sm-3">Plan</dt><dd class="col-sm-9">@tenant.PlanType</dd>
            <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@tenant.Status</dd>
            <dt class="col-sm-3">Ważna do</dt><dd class="col-sm-9">@(tenant.SubscriptionEndsAt?.ToString("dd.MM.yyyy") ?? "Brak")</dd>
        </dl>
        <div class="mt-3 d-flex gap-2 flex-wrap">
            <form asp-controller="Subscriptions" asp-action="UpdatePlan" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="tenantId" value="@tenant.Id" />
                <select name="planType" class="form-select d-inline-block" style="max-width: 200px;" required>
                    @{ var planOptions = new[] { "Starter", "Basic", "Standard", "Pro", "Enterprise", "Custom", "Local" }; }
                    @foreach (var plan in planOptions)
                    {
                        <option value="@plan" selected="@(plan == tenant.PlanType ? "selected" : null)">@plan</option>
                    }
                </select>
                <input type="date" name="subscriptionEndsAt" class="form-control d-inline-block" style="max-width: 170px;" value="@(tenant.SubscriptionEndsAt?.ToString("yyyy-MM-dd"))" />
                <button type="submit" class="btn btn-primary">Zapisz plan</button>
            </form>
            @if (tenant.IsActive)
            {
                <form asp-controller="Subscriptions" asp-action="Suspend" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="tenantId" value="@tenant.Id" />
                    <input type="text" name="reason" class="form-control d-inline-block" style="max-width: 220px;" placeholder="Powód zawieszenia" />
                    <button type="submit" class="btn btn-warning">Zawieś dostęp</button>
                </form>
            }
            else
            {
                <form asp-controller="Subscriptions" asp-action="Restore" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="tenantId" value="@tenant.Id" />
                    <button type="submit" class="btn btn-success">Przywróć dostęp</button>
                </form>
            }
        </div>
    </div>
}

@if (activeTab == "audit")
{
    <div class="table-container">
        <table class="table">
            <thead><tr><th>Data</th><th>Akcja</th><th>Szczegóły</th></tr></thead>
            <tbody>
                @foreach (var log in Model.AuditLogs)
                {
                    <tr>
                        <td>@log.DateUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@log.Action</td>
                        <td>@log.Details</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (activeTab == "reports")
{
    <div class="dashboard-card">
        <h3>Raporty tenanta</h3>
        <ul class="list-group list-group-flush">
            <li class="list-group-item">Użytkownicy: @Model.UserCount</li>
            <li class="list-group-item">Pojazdy: @Model.VehicleCount</li>
            <li class="list-group-item">Status: @tenant.Status</li>
            <li class="list-group-item">Plan: @tenant.PlanType</li>
        </ul>
    </div>
}
