@model FleetManagement.Core.Models.Tenant
@{
    ViewData["Title"] = "Edytuj tenant";
}

<div class="page-heading">
    <div>
        <h1 class="page-title">Edytuj tenant</h1>
        <p class="page-subtitle">Zmień dane firmowe oraz status subskrypcji.</p>
    </div>
</div>

<div class="dashboard-card mx-auto" style="max-width: 800px;">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Domain" class="form-label"></label>
                <input asp-for="Domain" class="form-control" />
                <span asp-validation-for="Domain" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Status" class="form-label"></label>
                <input asp-for="Status" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="IsActive" class="form-label"></label>
                <select asp-for="IsActive" class="form-select">
                    <option value="true">Aktywny</option>
                    <option value="false">Zawieszony</option>
                </select>
            </div>
            <div class="col-md-4">
                <label asp-for="SubscriptionEndsAt" class="form-label"></label>
                <input asp-for="SubscriptionEndsAt" class="form-control" type="date" />
            </div>
            <div class="col-12">
                <label asp-for="SuspensionReason" class="form-label"></label>
                <textarea asp-for="SuspensionReason" class="form-control" rows="3"></textarea>
            </div>
        </div>

        <div class="d-flex justify-content-between mt-4">
            <a asp-action="Details" asp-route-tenantId="@Model.Id" class="btn btn-outline-secondary">Anuluj</a>
            <button type="submit" class="btn btn-primary">Zapisz</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
