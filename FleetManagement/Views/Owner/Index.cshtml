@model IEnumerable<FleetManagement.Core.Models.Tenant>
@{
    ViewData["Title"] = "Panel właściciela";
}

<div class="page-heading">
    <div>
        <h1 class="page-title">Zarządzanie tenantami</h1>
        <p class="page-subtitle">Platforma lokalna – przegląd firm, administratorów i danych odseparowanych per tenant.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-2"></i>Nowy tenant
    </a>
</div>

@if (!Model.Any())
{
    <div class="dashboard-card">
        <h3>Brak tenantów</h3>
        <p>Dodaj pierwszą firmę, aby utworzyć lokalne środowisko multi-tenant.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var tenant in Model)
        {
            <div class="col-lg-6">
                <div class="dashboard-card h-100">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h3 class="mb-1">@tenant.Name</h3>
                            <div class="text-muted">@tenant.Domain</div>
                        </div>
                        <span class="badge rounded-pill bg-success-subtle text-success-emphasis px-3 py-2">@tenant.Status</span>
                    </div>

                    <dl class="row mb-3 small">
                        <dt class="col-sm-5">Slug</dt>
                        <dd class="col-sm-7">@tenant.Slug</dd>
                        <dt class="col-sm-5">Plan</dt>
                        <dd class="col-sm-7">@tenant.PlanType</dd>
                        <dt class="col-sm-5">Utworzono</dt>
                        <dd class="col-sm-7">@tenant.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</dd>
                    </dl>

                    <div class="d-flex gap-2 flex-wrap">
                        <a asp-controller="AdminTenants" asp-action="Details" asp-route-tenantId="@tenant.Id" class="btn btn-outline-primary btn-sm">Szczegóły</a>
                        <a asp-controller="AdminTenants" asp-action="Edit" asp-route-id="@tenant.Id" class="btn btn-outline-secondary btn-sm">Edytuj tenant</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
