@model FleetManagement.Core.Models.DailyReport

<h2>📍 Daily Report Details</h2>

<div class="card mb-3">
    <div class="card-body">
        <p><strong>Date:</strong> @Model.Date.ToShortDateString()</p>
        <p><strong>User:</strong> @Model.User.FullName (@Model.User.Email)</p>
        <p><strong>Vehicle:</strong> @Model.Vehicle.RegistrationNumber</p>
        <p><strong>Mileage:</strong> @Model.Mileage km</p>

        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <p><strong>Notes:</strong><br />@Model.Notes</p>
        }
    </div>
</div>

<h4>🧭 Route – Stops</h4>

@if (Model.Stops.Any())
{
    <ul class="list-group">
        @foreach (var s in Model.Stops)
        {
            <li class="list-group-item">
                <strong>@s.Stop.CompanyName</strong><br />
                <small>@s.Stop.Address</small>
            </li>
        }
    </ul>
}
else
{
    <div class="alert alert-info">
        No stops selected.
    </div>
}

<a asp-action="Index" class="btn btn-secondary mt-3">
    ⬅ Back
</a>
