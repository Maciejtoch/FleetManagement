@model FleetManagement.Core.Models.ServiceRecord

@{
    ViewData["Title"] = "Add Service Record";
    var vehicles = ViewBag.Vehicles as List<FleetManagement.Core.Models.Vehicle>;
}

<h2>🛠 Add Service Record</h2>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label class="form-label">Vehicle</label>
        <select asp-for="VehicleId" class="form-select" required>
            <option value="">-- select vehicle --</option>
            @foreach (var v in vehicles)
            {
                <option value="@v.Id">
                    @v.RegistrationNumber (@v.Make @v.Model)
                </option>
            }
        </select>
        <span asp-validation-for="VehicleId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Service Date</label>
        <input asp-for="ServiceDate" type="date" class="form-control" required />
        <span asp-validation-for="ServiceDate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Mileage (km)</label>
        <input asp-for="Mileage" type="number" class="form-control" required />
        <span asp-validation-for="Mileage" class="text-danger"></span>
    </div>


    <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea asp-for="Description" class="form-control" rows="4" required></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Cost</label>
        <input asp-for="Cost" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="Cost" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">
        💾 Save
    </button>

    <a asp-action="Index" class="btn btn-secondary ms-2">
        Cancel
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
