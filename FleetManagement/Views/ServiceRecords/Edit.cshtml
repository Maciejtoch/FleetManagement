@model FleetManagement.Core.Models.ServiceRecord
@{
    var vehicles = ViewBag.Vehicles as List<FleetManagement.Core.Models.Vehicle>;
}

<h2>✏ Edit Service Record</h2>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label>Vehicle</label>
        <select asp-for="VehicleId" class="form-select">
            @foreach (var v in vehicles)
            {
                <option value="@v.Id"
                        selected="@(v.Id == Model.VehicleId)">
                    @v.RegistrationNumber
                </option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label>Date</label>
        <input asp-for="ServiceDate" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Mileage</label>
        <input asp-for="Mileage" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Description</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label>Cost</label>
        <input asp-for="Cost" type="number" step="0.01" class="form-control" />
    </div>

    <button class="btn btn-success">💾 Save</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
</form>
