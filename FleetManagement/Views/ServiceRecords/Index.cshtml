@model IEnumerable<FleetManagement.Core.Models.ServiceRecord>

<h2>🛠 Service History</h2>

<a asp-action="Create" class="btn btn-primary mb-3">
    ➕ Add Service Entry
</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Date</th>
            <th>Vehicle</th>
            <th>Mileage</th>
            <th>Description</th>
            <th>Cost</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.ServiceDate.ToShortDateString()</td>
                <td>@r.Vehicle?.RegistrationNumber</td>
                <td>@r.Mileage km</td>
                <td>@r.Description</td>
                <td>@(r.Cost.HasValue ? $"{r.Cost} zł" : "-")</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@r.Id"
                       class="btn btn-sm btn-warning">
                        ✏ Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@r.Id"
                       class="btn btn-sm btn-danger ms-1">
                        🗑 Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
