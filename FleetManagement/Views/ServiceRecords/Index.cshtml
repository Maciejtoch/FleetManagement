@model IEnumerable<FleetManagement.Core.Models.ServiceRecord>

@{
    ViewData["Title"] = "Service Records";
}

<div class="page-heading">
    <div>
        <h1 class="page-title">Service history</h1>
        <p class="page-subtitle">Track maintenance work and service costs for vehicles.</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i>
        Add service entry
    </a>
</div>

<div class="table-container">
    <table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Vehicle</th>
                <th>Mileage</th>
                <th>Description</th>
                <th>Cost</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var record in Model)
            {
                <tr>
                    <td>@record.ServiceDate.ToShortDateString()</td>
                    <td>@record.Vehicle?.RegistrationNumber</td>
                    <td>@record.Mileage km</td>
                    <td>@record.Description</td>
                    <td>@(record.Cost.HasValue ? $"{record.Cost} zł" : "-")</td>
                    <td class="table-actions">
                        <a asp-action="Edit" asp-route-id="@record.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil"></i>
                            Edit
                        </a>
                        <a asp-action="Delete" asp-route-id="@record.Id" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-trash"></i>
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
