<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] – Fleet Management</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/app.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" />
</head>

<body class="app-body">

    <div class="app-wrapper">

        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="sidebar-header">
                🚗 Fleet Management
            </div>

            <nav class="sidebar-nav">
                <a asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-speedometer2 me-2"></i> Dashboard
                </a>

                <a asp-controller="DailyReports" asp-action="Create">
                    <i class="bi bi-pencil-square me-2"></i> New Report
                </a>

                <a asp-controller="DailyReports" asp-action="Index">
                    <i class="bi bi-journal-text me-2"></i> Reports History
                </a>
            </nav>
        </aside>

        <!-- MAIN -->
        <main class="main-content">

            <!-- TOPBAR -->


            <form asp-area="Identity"
                  asp-page="/Account/Logout"
                  method="post"
                  class="topbar-logout">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger btn-sm">
                    Logout
                </button>
            </form>
            </header>

            <section class="content">
                @RenderBody()
            </section>

        </main>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)

</body>
</html>
