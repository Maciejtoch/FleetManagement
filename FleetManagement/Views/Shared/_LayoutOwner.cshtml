<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] – Fleet Management</title>

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://unpkg.com/aos@2.3.1/dist/aos.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>

<body class="app-body">

    <div class="app-wrapper">

        <!-- SIDEBAR -->
        <aside class="sidebar">
            <a asp-controller="Dashboard"
               asp-action="Index"
               class="sidebar-header text-decoration-none d-block mb-4">
                🚚 Fleet Management
            </a>

            <nav class="sidebar-nav">
                <a asp-controller="Dashboard" asp-action="Index" data-aos="fade-right">
                    <i class="bi bi-speedometer2 me-2"></i><span data-i18n="dashboard">Dashboard</span>
                </a>

                <a asp-controller="Vehicles" asp-action="Index" data-aos="fade-right">
                    <i class="bi bi-truck me-2"></i><span data-i18n="vehicles">Vehicles</span>
                </a>

                <a asp-controller="Users" asp-action="Index" data-aos="fade-right">
                    <i class="bi bi-people me-2"></i><span data-i18n="users">Users</span>
                </a>

                <a asp-controller="Stops" asp-action="Index" data-aos="fade-right">
                    <i class="bi bi-geo-alt me-2"></i><span data-i18n="stops">Stops</span>
                </a>

                <a asp-controller="OwnerReports" asp-action="Index" data-aos="fade-right">
                    <i class="bi bi-bar-chart-line me-2"></i><span data-i18n="reports">Reports</span>
                </a>

                <a asp-controller="ServiceRecords" asp-action="Index" data-aos="fade-right">
                    <i class="bi bi-tools me-2"></i><span data-i18n="service">Service</span>
                </a>
            </nav>
        </aside>

        <!-- MAIN -->
        <main class="main-content">

            <header class="topbar d-flex justify-content-end align-items-center px-4">
                <div class="topbar-actions">
                    <label class="topbar-language" aria-label="Language selector">
                        <i class="bi bi-globe2"></i>
                        <select id="languageSelect" class="form-select form-select-sm">
                            <option value="en">EN</option>
                            <option value="pl">PL</option>
                        </select>
                    </label>
                    <button type="button" id="theme-toggle" class="btn btn-outline-secondary btn-sm" aria-label="Toggle dark mode">
                        <i class="bi bi-moon-stars"></i>
                        <span data-i18n="darkMode">Dark mode</span>
                    </button>
                    <span class="me-3 fw-semibold">@User.Identity.Name</span>
                </div>

                <form asp-area="Identity"
                      asp-page="/Account/Logout"
                      method="post"
                      class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-light btn-sm" data-i18n="logout">
                        Logout
                    </button>
                </form>
            </header>

            <section class="content">
                @RenderBody()
            </section>

        </main>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script src="~/js/app-i18n.js"></script>
    <script>
        (function () {
            function assignAosAttributes() {
                var selector = '.page-heading, .table-container, .dashboard-card, .card, .stat-card, .form-card, .action-tile, .content > *, .list-group';
                document.querySelectorAll(selector).forEach(function (element, index) {
                    if (element.closest('.leaflet-container')) {
                        return;
                    }
                    if (!element.hasAttribute('data-aos')) {
                        element.setAttribute('data-aos', 'fade-right');
                        element.setAttribute('data-aos-delay', String(index * 60));
                    }
                });
            }

            function initAos() {
                if (!window.AOS) {
                    return;
                }

                assignAosAttributes();
                AOS.init({
                    duration: 700,
                    once: true,
                    offset: 28,
                    easing: 'ease-out-cubic',
                    anchorPlacement: 'top-bottom'
                });
                AOS.refreshHard();
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initAos);
            } else {
                initAos();
            }

            window.addEventListener('load', initAos);
        })();

        (function () {
            const body = document.body;
            const toggle = document.getElementById('theme-toggle');
            const storedTheme = localStorage.getItem('fleet-theme') || 'light';

            const applyTheme = function (theme) {
                const isDark = theme === 'dark';
                body.classList.toggle('dark-mode', isDark);
                if (toggle) {
                    const icon = toggle.querySelector('i');
                    const label = toggle.querySelector('span');
                    if (icon) {
                        icon.className = isDark ? 'bi bi-sun' : 'bi bi-moon-stars';
                    }
                    if (label) {
                        label.textContent = isDark ? 'Light mode' : 'Dark mode';
                    }
                }
                if (window.fleetI18n && window.fleetI18n.applyLanguage) {
                    const lang = localStorage.getItem('fleet-language') || 'en';
                    window.fleetI18n.applyLanguage(lang);
                }
            };

            applyTheme(storedTheme);

            if (toggle) {
                toggle.addEventListener('click', function () {
                    const nextTheme = body.classList.contains('dark-mode') ? 'light' : 'dark';
                    localStorage.setItem('fleet-theme', nextTheme);
                    applyTheme(nextTheme);
                });
            }
        })();
    </script>

    @RenderSection("Scripts", required: false)

</body>
</html>
