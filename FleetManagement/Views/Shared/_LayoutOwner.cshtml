<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] – Fleet</title>

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/app.css" />
    <link rel="stylesheet" href="https://unpkg.com/aos@2.3.1/dist/aos.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">


</head>
<body class="app-body">

    <div class="app-wrapper">

        <!-- SIDEBAR -->
        <a asp-controller="Dashboard"
           asp-action="Index"
           class="sidebar-header text-decoration-none">
            🚚 Fleet Management
        </a>

            <nav class="sidebar-nav">
                <a asp-controller="Dashboard" asp-action="Index" data-aos="fade-right">Dashboard</a>
                <a asp-controller="Vehicles" asp-action="Index" data-aos="fade-right">Vehicles</a>
                <a asp-controller="Users" asp-action="Index" data-aos="fade-right">Users</a>
                <a asp-controller="Stops" asp-action="Index" data-aos="fade-right">Stops</a>
                <a asp-controller="OwnerReports" asp-action="Index" data-aos="fade-right">Reports</a>
                <a asp-controller="ServiceRecords" asp-action="Index" data-aos="fade-right">Service</a>
            </nav>
        </aside>

        <!-- MAIN -->
        <main class="main-content">
            <header class="topbar">
                <span>@User.Identity.Name</span>
                <form asp-area="Identity"
                      asp-page="/Account/Logout"
                      method="post"
                      class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-link nav-link p-0">
                        Logout
                    </button>
                </form>
            </header>

            <section class="content">
                @RenderBody()
            </section>
        </main>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init({
          duration: 700,
          easing: 'ease-out-cubic',
          once: true
        });
    </script>

</body>
</html>
