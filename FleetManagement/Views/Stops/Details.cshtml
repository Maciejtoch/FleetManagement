@model FleetManagement.Core.Models.Stop

<h2>Stop Details</h2>

<div class="card">
    <div class="card-body">
        <p><strong>Company:</strong> @Model.CompanyName</p>
        <p><strong>Address:</strong> @Model.Address</p>
    </div>
</div>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary mt-3">
    Edit
</a>
<a asp-action="Index" class="btn btn-secondary mt-3">
    Back
</a>
