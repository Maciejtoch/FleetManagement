@model IEnumerable<FleetManagement.Core.Models.Stop>

@{
    ViewData["Title"] = "Stops";
}

<div class="page-heading">
    <div>
        <h1 class="page-title">Stops</h1>
        <p class="page-subtitle">Manage delivery and service stop locations.</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i>
        Add stop
    </a>
</div>

<div class="table-container">
    <table class="table">
        <thead>
            <tr>
                <th>Company</th>
                <th>Address</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var stop in Model)
            {
                <tr>
                    <td>@stop.CompanyName</td>
                    <td>@stop.Address</td>
                    <td>
                        @if (stop.IsOnMap)
                        {
                            <span class="status-badge status-active">On map</span>
                        }
                        else
                        {
                            <span class="status-badge status-disabled">Not mapped</span>
                        }
                    </td>
                    <td class="table-actions">
                        <a asp-action="Details" asp-route-id="@stop.Id" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-eye"></i>
                            Details
                        </a>
                        <a asp-action="Edit" asp-route-id="@stop.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil"></i>
                            Edit
                        </a>
                        <a asp-action="Delete" asp-route-id="@stop.Id" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-trash"></i>
                            Delete
                        </a>

                        @if (stop.IsOnMap)
                        {
                            <a asp-action="RemoveFromMap" asp-route-id="@stop.Id" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-map"></i>
                                Remove
                            </a>
                        }
                        else
                        {
                            <a asp-action="AddToMap" asp-route-id="@stop.Id" class="btn btn-sm btn-primary">
                                <i class="bi bi-pin-map"></i>
                                Add to map
                            </a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>