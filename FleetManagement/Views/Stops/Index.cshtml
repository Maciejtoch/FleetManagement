@model IEnumerable<FleetManagement.Core.Models.Stop>

<h2>Stops</h2>

<a asp-action="Create" class="btn btn-primary mb-3">➕ Add Stop</a>

<table class="table">
    <tr>
        <th>Company</th>
        <th>Address</th>
        <th></th>
    </tr>
    @foreach (var s in Model)
    {
        <tr>
            <td>@s.CompanyName</td>
            <td>@s.Address</td>
            <td>
                <a asp-action="Details" asp-route-id="@s.Id">Details</a> |
                <a asp-action="Edit" asp-route-id="@s.Id">Edit</a> |
                <a asp-action="Delete" asp-route-id="@s.Id">Delete</a>
            </td>
        </tr>
    }
</table>
